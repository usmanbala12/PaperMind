<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PaperMind.ViewModels"
             x:Class="PaperMind.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="16" MaxWidth="800">
      <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"/>
      <TextBlock Text="Configure application settings" Foreground="#6A737D"/>

      <!-- General Settings -->
      <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="General" FontSize="16" FontWeight="SemiBold"/>
          
          <StackPanel Spacing="8">
            <TextBlock Text="Theme" FontWeight="Medium"/>
            <ComboBox Width="250" HorizontalAlignment="Left">
              <ComboBoxItem IsSelected="True">System</ComboBoxItem>
              <ComboBoxItem>Light</ComboBoxItem>
              <ComboBoxItem>Dark</ComboBoxItem>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- OCR Settings -->
      <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="OCR Settings" FontSize="16" FontWeight="SemiBold"/>
          
          <StackPanel Spacing="8">
            <TextBlock Text="Language" FontWeight="Medium"/>
            <ComboBox Width="250" HorizontalAlignment="Left">
              <ComboBoxItem IsSelected="True">English (eng)</ComboBoxItem>
              <ComboBoxItem>French (fra)</ComboBoxItem>
              <ComboBoxItem>German (deu)</ComboBoxItem>
              <ComboBoxItem>Spanish (spa)</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Quality" FontWeight="Medium"/>
            <ComboBox Width="250" HorizontalAlignment="Left">
              <ComboBoxItem>Fast</ComboBoxItem>
              <ComboBoxItem IsSelected="True">Balanced</ComboBoxItem>
              <ComboBoxItem>High</ComboBoxItem>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- LLM Settings -->
      <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="LLM Provider" FontSize="16" FontWeight="SemiBold"/>
          
          <StackPanel Spacing="8">
            <TextBlock Text="Provider" FontWeight="Medium"/>
            <ComboBox Width="250" HorizontalAlignment="Left">
              <ComboBoxItem IsSelected="True">OpenAI</ComboBoxItem>
              <ComboBoxItem>Anthropic</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Model" FontWeight="Medium"/>
            <TextBox Width="350" HorizontalAlignment="Left" 
                     Watermark="e.g., gpt-4o-mini or claude-3-haiku-20240307"/>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="API Key" FontWeight="Medium"/>
            <TextBox Width="450" HorizontalAlignment="Left" 
                     PasswordChar="*"
                     Watermark="Enter your API key"/>
            <TextBlock Text="Your API key is stored securely" 
                       FontSize="11" Foreground="#6A737D"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Performance Settings -->
      <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="Performance" FontSize="16" FontWeight="SemiBold"/>
          
          <StackPanel Spacing="8">
            <TextBlock Text="Max Concurrent Operations" FontWeight="Medium"/>
            <NumericUpDown Width="150" HorizontalAlignment="Left" 
                           Value="2" Minimum="1" Maximum="10" Increment="1"/>
            <TextBlock Text="Higher values use more CPU and memory" 
                       FontSize="11" Foreground="#6A737D"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Cloud Storage Settings -->
      <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="Cloud Storage" FontSize="16" FontWeight="SemiBold"/>
          
          <StackPanel Spacing="8">
            <TextBlock Text="Storage Provider" FontWeight="Medium"/>
            <ComboBox Width="250" HorizontalAlignment="Left" 
                      ItemsSource="{Binding AvailableStorageProviders}"
                      SelectedItem="{Binding StorageProvider}"/>
          </StackPanel>

          <!-- Google Drive Settings -->
          <StackPanel Spacing="12" IsVisible="{Binding IsGoogleDriveSelected}">
            <TextBlock Text="Google Drive Configuration" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>
            
            <StackPanel Spacing="8">
              <TextBlock Text="Client ID" FontWeight="Medium"/>
              <TextBox Width="450" HorizontalAlignment="Left" Text="{Binding GoogleDriveClientId}" PasswordChar="*"/>
            </StackPanel>
            
            <StackPanel Spacing="8">
              <TextBlock Text="Client Secret" FontWeight="Medium"/>
              <TextBox Width="450" HorizontalAlignment="Left" Text="{Binding GoogleDriveClientSecret}" PasswordChar="*"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Folder ID (Optional)" FontWeight="Medium"/>
              <TextBox Width="350" HorizontalAlignment="Left" Text="{Binding GoogleDriveFolderId}" Watermark="Leave empty for root"/>
              <TextBlock Text="The ID of the folder to upload to (from URL)" FontSize="11" Foreground="#6A737D"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Connect to Google Drive" Command="{Binding ConnectGoogleDriveCommand}" IsEnabled="{Binding !IsGoogleDriveConnected}"/>
                <TextBlock Text="Connected" Foreground="Green" VerticalAlignment="Center" IsVisible="{Binding IsGoogleDriveConnected}"/>
            </StackPanel>
          </StackPanel>

          <!-- Dropbox Settings -->
          <StackPanel Spacing="12" IsVisible="{Binding IsDropboxSelected}">
            <TextBlock Text="Dropbox Configuration" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>
            
            <StackPanel Spacing="8">
              <TextBlock Text="App Key" FontWeight="Medium"/>
              <TextBox Width="450" HorizontalAlignment="Left" Text="{Binding DropboxAppKey}" PasswordChar="*"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Access Token" FontWeight="Medium"/>
              <TextBox Width="450" HorizontalAlignment="Left" Text="{Binding DropboxAccessToken}" PasswordChar="*"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Folder Path (Optional)" FontWeight="Medium"/>
              <TextBox Width="350" HorizontalAlignment="Left" Text="{Binding DropboxFolderPath}" Watermark="/PaperMind"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Connect to Dropbox" Command="{Binding ConnectDropboxCommand}" IsEnabled="{Binding !IsDropboxConnected}"/>
                <TextBlock Text="Connected" Foreground="Green" VerticalAlignment="Center" IsVisible="{Binding IsDropboxConnected}"/>
            </StackPanel>
          </StackPanel>

          <!-- OneDrive Settings -->
          <StackPanel Spacing="12" IsVisible="{Binding IsOneDriveSelected}">
            <TextBlock Text="OneDrive Configuration" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>
            
            <StackPanel Spacing="8">
              <TextBlock Text="Client ID" FontWeight="Medium"/>
              <TextBox Width="450" HorizontalAlignment="Left" Text="{Binding OneDriveClientId}" PasswordChar="*"/>
            </StackPanel>
            
            <StackPanel Spacing="8">
              <TextBlock Text="Tenant ID" FontWeight="Medium"/>
              <TextBox Width="450" HorizontalAlignment="Left" Text="{Binding OneDriveTenantId}" PasswordChar="*"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Folder Path (Optional)" FontWeight="Medium"/>
              <TextBox Width="350" HorizontalAlignment="Left" Text="{Binding OneDriveFolderPath}" Watermark="/PaperMind"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Connect to OneDrive" Command="{Binding ConnectOneDriveCommand}" IsEnabled="{Binding !IsOneDriveConnected}"/>
                <TextBlock Text="Connected" Foreground="Green" VerticalAlignment="Center" IsVisible="{Binding IsOneDriveConnected}"/>
            </StackPanel>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- Action Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Save Settings" Command="{Binding SaveCommand}" Width="120" 
                Background="#28a745" Foreground="White" Padding="8"/>
        <Button Content="Reset" Command="{Binding ResetCommand}" Width="100" Padding="8"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
