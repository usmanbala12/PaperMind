<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PaperMind.Views.JobsView"
             x:Name="Root"
             xmlns:vm="using:PaperMind.ViewModels"
             xmlns:conv="using:PaperMind.Converters"
             x:DataType="vm:JobsViewModel">
  <UserControl.Resources>
    <conv:StepTypeVisibilityConverter x:Key="StepTypeVisibilityConverter"/>
  </UserControl.Resources>
  <Grid ColumnDefinitions="340,*" Background="#F8F9FA">
    <!-- Left: New Job Form -->
    <Border Grid.Column="0" Background="White" BorderBrush="#E1E4E8" BorderThickness="0,0,1,0" Padding="24">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="Create Processing Job" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Select folders, steps and save or start" Foreground="#6A737D"/>
          </StackPanel>

          <Separator Background="#E1E4E8" Height="1"/>

          <!-- Input -->
          <StackPanel Spacing="6">
            <TextBlock Text="Input Folder" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto">
              <Border Grid.Column="0" Background="#F6F8FA" BorderBrush="#D1D5DA" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <TextBlock Text="{Binding InputFolder}" TextTrimming="CharacterEllipsis">
                  <TextBlock.Styles>
                    <Style Selector="TextBlock[Text='']">
                      <Setter Property="Text" Value="No folder selected"/>
                      <Setter Property="Foreground" Value="#959DA5"/>
                    </Style>
                  </TextBlock.Styles>
                </TextBlock>
              </Border>
              <Button Grid.Column="1" Content="📂" Command="{Binding SelectInputFolderCommand}" Width="40" Height="34" Margin="6,0,0,0" Background="#0366D6" Foreground="White" CornerRadius="6"/>
            </Grid>
          </StackPanel>

          <!-- Output -->
          <StackPanel Spacing="6">
            <TextBlock Text="Output Folder" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto">
              <Border Grid.Column="0" Background="#F6F8FA" BorderBrush="#D1D5DA" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <TextBlock Text="{Binding OutputFolder}" TextTrimming="CharacterEllipsis">
                  <TextBlock.Styles>
                    <Style Selector="TextBlock[Text='']">
                      <Setter Property="Text" Value="No folder selected"/>
                      <Setter Property="Foreground" Value="#959DA5"/>
                    </Style>
                  </TextBlock.Styles>
                </TextBlock>
              </Border>
              <Button Grid.Column="1" Content="📂" Command="{Binding SelectOutputFolderCommand}" Width="40" Height="34" Margin="6,0,0,0" Background="#0366D6" Foreground="White" CornerRadius="6"/>
            </Grid>
          </StackPanel>

          <Separator Background="#E1E4E8" Height="1"/>

          <!-- Steps -->
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Pipeline Steps" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="4" Grid.Column="1">
                    <ComboBox ItemsSource="{Binding AvailableStepTypes}" SelectedItem="{Binding SelectedStepTypeToAdd}" Width="160"/>
                    <Button Content="+" Command="{Binding AddStepCommand}" Width="30"/>
                </StackPanel>
            </Grid>
            
            <ItemsControl ItemsSource="{Binding PipelineSteps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F6F8FA" BorderBrush="#D1D5DA" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                            <StackPanel Spacing="8">
                                <!-- Header -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Grid.Column="1">
                                        <Button Content="↑" Command="{Binding DataContext.MoveStepUpCommand, ElementName=Root}" CommandParameter="{Binding}" Padding="4,2" FontSize="10"/>
                                        <Button Content="↓" Command="{Binding DataContext.MoveStepDownCommand, ElementName=Root}" CommandParameter="{Binding}" Padding="4,2" FontSize="10"/>
                                        <Button Content="✕" Command="{Binding DataContext.RemoveStepCommand, ElementName=Root}" CommandParameter="{Binding}" Padding="4,2" FontSize="10" Foreground="#DC3545"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Config: OCR -->
                                <StackPanel IsVisible="{Binding StepType, Converter={StaticResource StepTypeVisibilityConverter}, ConverterParameter='OcrToSearchablePdf'}" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Language:" VerticalAlignment="Center" Width="70"/>
                                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding OcrLanguage}" Width="120"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Quality:" VerticalAlignment="Center" Width="70"/>
                                        <ComboBox ItemsSource="{Binding AvailableQualities}" SelectedItem="{Binding OcrQuality}" Width="120"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Config: Upload -->
                                <StackPanel IsVisible="{Binding StepType, Converter={StaticResource StepTypeVisibilityConverter}, ConverterParameter='UploadToCloud'}" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Provider:" VerticalAlignment="Center" Width="70"/>
                                        <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding UploadProvider}" Width="120"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Config: Rename -->
                                <StackPanel IsVisible="{Binding StepType, Converter={StaticResource StepTypeVisibilityConverter}, ConverterParameter='LlmRename'}" Spacing="6">
                                    <TextBlock Text="Uses default prompt from settings." FontStyle="Italic" Foreground="Gray"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- OCR Options moved to step config -->

          <!-- Actions -->
          <StackPanel Spacing="8">
            <Button Content="💾 Save Job" Command="{Binding SaveJobCommand}" IsEnabled="{Binding CanSave}" Height="40" CornerRadius="6" Background="#6f42c1" Foreground="White"/>
            <Button Content="▶️ Start Job" Command="{Binding StartJobCommand}" IsEnabled="{Binding CanStart}" Height="44" CornerRadius="6" Background="#28A745" Foreground="White"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Right: Jobs List -->
    <Grid Grid.Column="1" Margin="24" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock Text="Jobs" FontSize="24" FontWeight="Bold"/>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshJobsCommand}"/>
      </Grid>
      <Border Grid.Row="1" Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8">
        <ScrollViewer>
          <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob, Mode=OneWayToSource}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#E1E4E8" BorderThickness="0,0,0,1" Padding="12">
                  <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding InputFolder}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding OutputFolder}" Foreground="#6A737D"/>
                    <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding Status}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding Errors.Count, StringFormat='({0} errors)'}" Foreground="#DC3545" Margin="12,20,0,0" VerticalAlignment="Center" IsVisible="{Binding Errors.Count}"/>
                    <Button Grid.Column="2" Grid.RowSpan="2" Content="Open" Command="{Binding DataContext.OpenJobCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
