<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PaperMind.Views.JobsView"
             x:Name="Root"
             xmlns:vm="using:PaperMind.ViewModels"
             xmlns:conv="using:PaperMind.Converters"
             x:DataType="vm:JobsViewModel">
  <UserControl.Resources>
    <conv:StepTypeVisibilityConverter x:Key="StepTypeVisibilityConverter"/>
  </UserControl.Resources>
  
  <Grid Margin="24" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="Jobs" FontSize="24" FontWeight="Bold"/>
        <Button Grid.Column="1" Content="Create New Job" Command="{Binding CreateJobCommand}" Margin="0,0,12,0" Background="#28A745" Foreground="White"/>
        <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshJobsCommand}"/>
      </Grid>
      <Border Grid.Row="1" Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0">
        <ScrollViewer>
          <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob, Mode=OneWayToSource}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#E1E4E8" BorderThickness="0,0,0,1" Padding="12">
                  <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding InputFolder}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding OutputFolder}" Foreground="#6A737D"/>
                    <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding Status}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding Errors.Count, StringFormat='({0} errors)'}" Foreground="#DC3545" Margin="12,20,0,0" VerticalAlignment="Center" IsVisible="{Binding Errors.Count}"/>
                    
                    <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="Edit" Command="{Binding DataContext.EditJobCommand, ElementName=Root}" CommandParameter="{Binding}" IsVisible="{Binding Status, Converter={StaticResource StepTypeVisibilityConverter}, ConverterParameter='Pending'}"/> 
                        <Button Content="Delete" Command="{Binding DataContext.DeleteJobCommand, ElementName=Root}" CommandParameter="{Binding}" Foreground="#DC3545"/>
                        <Button Content="Open" Command="{Binding DataContext.OpenJobCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Border>
  </Grid>
</UserControl>
